{
  "openapi": "3.1.0",
  "info": {
    "title": "Acme Cloud API",
    "version": "1.0.0",
    "description": "Публичный API Acme Cloud для агентов."
  },
  "servers": [{ "url": "http://localhost:4105" }],
  "paths": {
    "/api/products": {
      "get": {
        "operationId": "listProducts",
        "summary": "Список тарифов",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Product" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Product": {
        "type": "object",
        "required": ["id", "name", "price", "currency"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "price": { "type": "number" },
          "currency": { "type": "string" }
        }
      }
    }
  }
}
